fastcgi_cache_path /var/cache/nginx/fastcgi_cache levels=1:2 keys_zone=drupal:10m max_size=1g inactive=60m use_temp_path=off;
fastcgi_cache_key "$scheme$request_method$host$request_uri";

server {
    listen 80;
    server_name ${DOMAIN_NAME};
    root /var/www/html/web;
    index index.php index.html index.htm;

    # Bypass cache for authenticated users and specific paths
    set $skip_cache 0;
    if ($request_method = POST) {
        set $skip_cache 1;
    }
    if ($query_string != "") {
        set $skip_cache 1;
    }
    # Drupal specific: bypass cache if session cookie is set
    if ($http_cookie ~* "SESS") {
        set $skip_cache 1;
    }
    if ($request_uri ~* "/(admin|user|update.php|cron.php|core/install.php|install.php|xmlrpc.php)") {
        set $skip_cache 1;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ '\.php$|^/update.php' {
        fastcgi_split_path_info ^(.+?\.php)(|/.*)$;

        # Security note: Ensure that the file exists before passing to PHP-FPM
        try_files $fastcgi_script_name =404;

        include fastcgi_params;

        fastcgi_param HTTP_PROXY "";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_intercept_errors on;

        fastcgi_pass drupal:9000;

        # FastCGI caching
        fastcgi_cache drupal;
        fastcgi_cache_valid 200 301 302 60m;
        fastcgi_cache_use_stale error timeout updating invalid_header http_500 http_503;
        fastcgi_cache_min_uses 1;
        fastcgi_cache_lock on;
        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache $skip_cache;

        add_header X-FastCGI-Cache $upstream_cache_status;
    }

    # Files mapping
    location ~ ^/sites/[^/]+/files/ {
        try_files $uri @rewrite;
    }

    # Hide private files
    location ~ ^/sites/[^/]+/private/ {
        internal;
    }

    # Block access to specific files
    location ~* \.(engine|inc|install|make|module|profile|po|sh|.*sql|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|/(\.(?!well-known).*|Entries.*|Repository|Root|Tag|Template|composer\.(json|lock)|web\.config)$|/#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$ {
        deny all;
        return 404;
    }

    location @rewrite {
        rewrite ^ /index.php;
    }
}